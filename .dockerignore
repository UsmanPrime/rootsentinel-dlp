# Keep the build context small and free of local state, secrets and tests.
.git
.github
.playwright-mcp
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/tests
agent
docs
fixtures
scripts
.env
.env.*
!.env.example
*.pem
*.key
*.sqlite*
*.db
audit-keys.json
accounts.json
checkpoint-*.json
# Root-level notes and documents: the image needs none of them (the Dockerfile copies only frontend/,
# backend/ and docker/entrypoint.sh), so no local note can reach the build context.
/*.md
/*.txt
