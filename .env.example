# Paths are interpreted by the application; no secret values belong here.
# Defaults use LOCALAPPDATA on Windows and XDG_DATA_HOME on Linux.
# Override with absolute paths OUTSIDE the repository and synchronized folders.
# ROOTSENTINEL_RUNTIME_ROOT=
# ROOTSENTINEL_ARTIFACT_ROOT=
# Phase 02 defaults to public_demo, which refuses all operational API requests.
# Set these only for local loopback development; use process environment variables.
# ROOTSENTINEL_MODE=local
# ROOTSENTINEL_ORIGIN=http://127.0.0.1:5173
# ROOTSENTINEL_SECURE_COOKIES=false
# ROOTSENTINEL_DATABASE_URL=  (unset: SQLite under external runtime/database)
# ROOTSENTINEL_API_PORT=8000  (Vite proxy/browser harness only)
# Never add credentials or a real connection URL to this file.

# Phase 03: absolute PRIVATE external paths, separate from runtime/database/OneDrive.
# Set values in your local shell. Never commit the actual keyring.
# ROOTSENTINEL_AUDIT_KEY_FILE=
# ROOTSENTINEL_CHECKPOINT_ROOT=

# Phase 05 staging agent (a separate process). Names only; credentials NEVER go in environment
# variables or in this file: use a private 0600 credentials file or the hidden prompt.
# ROOTSENTINEL_AGENT_ROOT=        (parent of staging/, outbound/, quarantine/, state/)
# ROOTSENTINEL_AGENT_BASE_URL=http://127.0.0.1:8000
# ROOTSENTINEL_AGENT_ORIGIN=http://127.0.0.1:5173   (must equal the gateway's ROOTSENTINEL_ORIGIN)
