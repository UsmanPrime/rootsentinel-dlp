# Paths are interpreted by the application; no secret values belong here.
# Defaults use LOCALAPPDATA on Windows and XDG_DATA_HOME on Linux.
# Override with absolute paths OUTSIDE the repository and synchronized folders.
# ROOTSENTINEL_RUNTIME_ROOT=
# ROOTSENTINEL_ARTIFACT_ROOT=
# The default mode is public_demo, which refuses all operational API requests.
# Set these only for local loopback development; use process environment variables.
# ROOTSENTINEL_MODE=local
# ROOTSENTINEL_ORIGIN=http://127.0.0.1:5173
# ROOTSENTINEL_SECURE_COOKIES=false
# ROOTSENTINEL_DATABASE_URL=  (unset: SQLite at <runtime>/database/rootsentinel.sqlite3)
# ROOTSENTINEL_API_PORT=8000  (Vite proxy and browser test server only)
# ROOTSENTINEL_FRONTEND_DIST= (optional absolute build output directory outside OneDrive; default frontend/dist)
# Never add credentials or a real connection URL to this file.

# Audit integrity: absolute PRIVATE external paths, separate from runtime/database/OneDrive.
# Set values in your local shell. Never commit the actual keyring.
# ROOTSENTINEL_AUDIT_KEY_FILE=
# ROOTSENTINEL_CHECKPOINT_ROOT=
# The Ed25519 key that signs audit tree heads: a separate private file, created with
# "python -m app.audit_keys init-transparency <path>". Without it nothing can be released.
# ROOTSENTINEL_TRANSPARENCY_KEY_FILE=

# Staging agent (a separate process). Names only; credentials NEVER go in environment
# variables or in this file: use a private 0600 credentials file or the hidden prompt.
# ROOTSENTINEL_AGENT_ROOT=        (parent of staging/, outbound/, quarantine/, state/)
# ROOTSENTINEL_AGENT_BASE_URL=http://127.0.0.1:8000
# ROOTSENTINEL_AGENT_ORIGIN=http://127.0.0.1:5173   (must equal the gateway's ROOTSENTINEL_ORIGIN)

# Hosted presenter demo (set as platform environment variables; see docs/deployment.md).
# The hosted image runs with ROOTSENTINEL_MODE=local over an https origin. Names only, no values here.
# ROOTSENTINEL_ORIGIN=            (exact public https origin, e.g. https://<service>.onrender.com, no trailing slash)
# ROOTSENTINEL_DATABASE_URL=      (postgresql+psycopg://... ; set only in the platform dashboard)
# ROOTSENTINEL_FRONTEND_DIR=      (absolute directory of the built frontend; the image sets it)
# ROOTSENTINEL_TRUSTED_PROXY_HOPS=0   (0 to 5; 0 = ignore X-Forwarded-For; N = take the Nth entry from the right)
# ROOTSENTINEL_CLIENT_IP_HEADER=      (empty = off; one header holding exactly one client address, set by the edge;
#                                      the hosted demo uses True-Client-IP; cannot be combined with nonzero hops)
# ROOTSENTINEL_EXTRA_HOSTS=       (comma separated exact extra Host values, no wildcards, e.g. a custom domain)
# ROOTSENTINEL_SESSION_SECONDS=3600   (60 to 86400)
# ROOTSENTINEL_RETENTION_SECONDS=900  (1 to 900)
# ROOTSENTINEL_MAX_UPLOAD_BYTES=10485760   (1024 to 10485760; the hosted demo uses 1048576)
# ROOTSENTINEL_TRANSFER_RATE_PER_MINUTE=30 (1 to 120, per account; the hosted demo uses 10)
# ROOTSENTINEL_VISITOR_MODE_ENABLED=false   (true enables visitor mode; the hosted demo sets true in render.yaml)
# Visitor caps, each bounded in code (docs/visitor-mode.md): ROOTSENTINEL_VISITOR_ENTRIES_PER_IP_HOUR=6 (1 to 60),
# ROOTSENTINEL_VISITOR_MAX_CONCURRENT=10 (1 to 50), ROOTSENTINEL_VISITOR_SESSIONS_PER_DAY=30 (1 to 200),
# ROOTSENTINEL_VISITOR_SCANS_PER_SESSION=3 (1 to 10), ROOTSENTINEL_VISITOR_UPLOAD_BYTES=65536 (1024 to 262144),
# ROOTSENTINEL_VISITOR_AUDIT_CEILING=14000 (1000 to 18000)
# ROOTSENTINEL_COMMIT=            (build argument, not a runtime secret: the commit /health reports; CI passes the Git SHA)
# Secret FILES, not variables: the audit key and the account-hash file (docs/deployment.md).
# ROOTSENTINEL_AUDIT_KEY_SOURCE=/etc/secrets/audit-keys.json   (entrypoint input; default shown)
# ROOTSENTINEL_TRANSPARENCY_KEY_SOURCE=/etc/secrets/transparency-key.json   (entrypoint input; default shown)
# ROOTSENTINEL_ACCOUNTS_SOURCE=/etc/secrets/accounts.json      (entrypoint input; default shown)
